generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  role          String    @default("agent")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  callSessions  CallSession[]
}

model CallSession {
  id            String    @id @default(uuid())
  agentId       String
  agent         User      @relation(fields: [agentId], references: [id])
  prospectName  String?
  prospectPhone String?
  status        String    @default("active") // active | ended
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  transcript    Transcript[]
  suggestions   AISuggestion[]
}

model Transcript {
  id            String    @id @default(uuid())
  sessionId     String
  session       CallSession @relation(fields: [sessionId], references: [id])
  speaker       String    // agent | prospect
  text          String
  confidence    Float?
  timestamp     DateTime  @default(now())
  startMs       Int?
  endMs         Int?
}

model AISuggestion {
  id            String    @id @default(uuid())
  sessionId     String
  session       CallSession @relation(fields: [sessionId], references: [id])
  type          String    // product_info | objection_handler | compliance | tip
  content       String
  trigger       String?
  shown         Boolean   @default(false)
  accepted      Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

model Product {
  id            String    @id @default(uuid())
  name          String
  category      String    // term | whole | universal | final_expense
  description   String
  features      String[]
  targetAge     String?
  priceRange    String?
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model KnowledgeBase {
  id            String    @id @default(uuid())
  category      String    // objection | script | compliance | faq
  title         String
  content       String
  tags          String[]
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
