# Database
DATABASE_URL=postgresql://copilot:copilot_dev@localhost:5432/copilot

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic (primary LLM provider)
ANTHROPIC_API_KEY=sk-ant-xxxx

# OpenRouter (fallback LLM provider)
OPENROUTER_API_KEY=sk-or-xxxx

# LLM role-to-model mapping (per D-14)
LLM_CLASSIFICATION_MODEL=claude-opus-4-6
LLM_SUGGESTION_MODEL=claude-opus-4-6
LLM_GUARDRAIL_MODEL=claude-opus-4-6
LLM_GENERATION_MODEL=claude-opus-4-6
LLM_POST_CALL_ANALYSIS_MODEL=claude-opus-4-6
LLM_FALLBACK_MODEL=anthropic/claude-opus-4.6

# App
NODE_ENV=development
PORT=3000
WS_PORT=3001
