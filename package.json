{
  "name": "life-insurance-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names next,ws --prefix-colors blue,green \"next dev --turbopack\" \"npx tsx --watch src/server/index.ts\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "npx tsx src/lib/db/seed.ts",
    "db:embed": "npx tsx scripts/embed-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.80.0",
    "@deepgram/sdk": "^3.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.1",
    "ioredis": "5.10.1",
    "lucide-react": "^1.7.0",
    "next": "15.5.14",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.0.3",
    "voyageai": "^0.2.1",
    "ws": "8.20.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.14",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
